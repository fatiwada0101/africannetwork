{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "regions": ["lhr1"],
  "crons": [
    {
      "path": "/api/cron/expire-vouchers",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/auto-renew",
      "schedule": "*/10 * * * *"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
